{
  "name": "smart-app",
  "version": "1.0.0",
  "description": "Smart Desktop Artificial Intelligence Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "electron": "^27.0.0"
  },
  "keywords": [],
  "author": "SmartApp Developer",
  "license": "ISC",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-squirrel-startup": "^1.0.0",
    "postject": "^1.0.0-alpha.6"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "extraResource": [
          "./models"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "smart_app"
          }
        }
      ]
    }
  }
}
